echo "Replacing LCM881.LIB"
copy Lattice_5.04_Patch:libo/lcm881.lib LIB: clone


cd ram:
delete TEMPLIB QUIET


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;       Replace header files       ;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

echo "Replacing Header Files"

makedir ram:h
makedir ram:h/proto
makedir ram:h/workbench
makedir ram:h/intuition

cd Lattice_5.04_Patch:compiler_headers

lpatch -oram:h/assert.h -passert.pch HEADER:assert.h
lpatch -oram:h/dos.h -pdos.pch HEADER:dos.h
lpatch -oram:h/fcntl.h -pfcntl.pch HEADER:fcntl.h
lpatch -oram:h/ios1.h -pios1.pch HEADER:ios1.h
lpatch -oram:h/m68881.h -pm68881.pch HEADER:m68881.h
lpatch -oram:h/math.h -pmath.pch HEADER:math.h
lpatch -oram:h/signal.h -psignal.pch HEADER:signal.h
lpatch -oram:h/stddef.h -pstddef.pch HEADER:stddef.h
lpatch -oram:h/stdio.h -pstdio.pch HEADER:stdio.h
lpatch -oram:h/stdlib.h -pstdlib.pch HEADER:stdlib.h
lpatch -oram:h/string.h -pstring.pch HEADER:string.h
lpatch -oram:h/intuition/preferences.h -pintuition/preferences.pch HEADER:intuition/preferences.h
lpatch -oram:h/proto/dos.h -pproto/dos.pch HEADER:proto/dos.h
lpatch -oram:h/proto/icon.h -pproto/icon.pch HEADER:proto/icon.h
lpatch -oram:h/workbench/icon.h -pworkbench/icon.pch HEADER:workbench/icon.h
copy mffp.h ram:h clone
copy mieeedoub.h ram:h clone
copy ram:h HEADER: all clone

cd ram:h

echo "Replacing Compact Header Files"
lcompact <assert.h >INCLUDE:assert.h
lcompact <dos.h >INCLUDE:dos.h 
lcompact <fcntl.h >INCLUDE:fcntl.h
lcompact <ios1.h >INCLUDE:ios1.h
lcompact <m68881.h >INCLUDE:m68881.h
lcompact <math.h >INCLUDE:math.h
lcompact <mffp.h >INCLUDE:mffp.h
lcompact <mieeedoub.h >INCLUDE:mieeedoub.h
lcompact <signal.h >INCLUDE:signal.h
lcompact <stddef.h >INCLUDE:stddef.h
lcompact <stdio.h >INCLUDE:stdio.h
lcompact <stdlib.h >INCLUDE:stdlib.h 
lcompact <string.h >INCLUDE:string.h
lcompact <intuition/preferences.h >INCLUDE:intuition/preferences.h
lcompact <proto/dos.h >INCLUDE:proto/dos.h
lcompact <proto/icon.h >INCLUDE:proto/icon.h
lcompact <workbench/icon.h >INCLUDE:workbench/icon.h

cd ram:
delete h all quiet

echo
echo "Lattice C 5.04 patch installation completed."
